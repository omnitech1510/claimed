# Supabase (Settings > API in your Supabase project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chapa (dashboard.chapa.co > Settings > API)
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
CHAPA_WEBHOOK_SECRET=
# Create this once in the Chapa dashboard under Plans, paste the id here
CHAPA_MONTHLY_PLAN_ID=

# Your own "control room" password (make this a real password, not a placeholder)
ADMIN_PASSWORD=change-me

# Web Push (generate with: npm run gen:vapid)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# The live URL of your site once deployed, e.g. https://claimed.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
